# Finais de linha fixados pelo repositório, não pelo core.autocrlf de cada máquina (HARNESS §A19).
* text=auto eol=lf

# Script do Windows fica em CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
